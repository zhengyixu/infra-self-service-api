# Shared editor settings: https://editorconfig.org
# shfmt reads the [*.sh] section directly, so editor, CLI and CI agree on one style.
root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.sh]
indent_style = space
indent_size = 2
# shfmt -ci: indent case branches inside switch statements
switch_case_indent = true
# shfmt -bn: binary operators like && and | may start a line
binary_next_line = true

[*.{java,xml}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.cmd]
end_of_line = crlf
